{
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "SmartQueueAPI",
    "Audience": "SmartQueueClient",
    "ExpiryHours": 24
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName"
    ]
  }
}